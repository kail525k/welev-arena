{
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(models|guns)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/bugak",
      "destination": "https://unfinished-war.vercel.app/",
      "permanent": false
    },
    {
      "source": "/bugak/:path*",
      "destination": "https://unfinished-war.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/unfinished-war",
      "destination": "https://unfinished-war.vercel.app/",
      "permanent": false
    },
    {
      "source": "/unfinished-war/:path*",
      "destination": "https://unfinished-war.vercel.app/:path*",
      "permanent": false
    }
  ]
}
